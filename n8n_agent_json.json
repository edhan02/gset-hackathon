        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        864,
        208
      ],
      "id": "b924bd6b-c530-4e32-b3e0-0afd7f2a984d",
      "name": "Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "description": "Rule-based scam cue detector. Input: the full message/transcript text as a string. Returns JSON with rule_score (0-100), rule_level, categories and highlights (exact matched phrases with category and why).",
        "jsCode": "function analyze(text) {\n  const t = String(text || '');\n  const cats = [\n    { key: 'fake_authority', label: 'Fake authority', weight: 25,\n      why: 'Scammers pose as police, CBI, courts or other officials to scare you. Real agencies do not run investigations over WhatsApp/Skype/phone calls.',\n      re: /\\b(cbi|cyber ?crime( branch| police)?|enforcement directorate|ed officer|narcotics|ncb|customs (officer|department)|trai|supreme court|high court|rbi officer|inspector|police officer|officer from|court order|arrest warrant|digital(ly)? arrest(ed)?|fir (has been|is|registered)|mumbai police|delhi police)\\b/gi },\n    { key: 'threat', label: 'Threat of arrest / legal action', weight: 25,\n      why: 'Threats of arrest or legal trouble are used to make you panic and stop thinking clearly.',\n      re: /\\b(you (will|are going to) be arrested|arrest(ed)? (you )?(today|now)?|jail|legal action|case (has been )?(registered|filed)|money laundering|linked to (a |an )?(crime|case|illegal)|involved in (a |an )?(crime|case)|(aadhaar|sim|number|account|parcel|package)[^.]{0,40}(misused|blocked|frozen|seized|illegal|drugs|contraband|suspended)|drugs? (case|found|in (your )?(parcel|package)))\\b/gi },\n    { key: 'urgency', label: 'Extreme urgency', weight: 15,\n      why: 'Artificial deadlines are meant to stop you from verifying or asking anyone.',\n      re: /\\b(right now|immediately|at once|within \\d+ ?(minutes?|mins?|hours?)|(by|before) (today|tonight)|urgent(ly)?|last warning|final notice|don'?t delay|without delay)\\b/gi },\n    { key: 'secrecy', label: 'Secrecy / isolation demand', weight: 20,\n      why: 'Genuine authorities never ask you to hide a case from family, friends or your bank. Isolation is a classic scam tactic.',\n      re: /\\b(do not|don'?t|never) (tell|inform|share (this )?with|discuss (this )?with|speak to|talk to)( anyone| family| your family| your bank|[^.]{0,20}anyone)|keep (this|it|the matter) (strictly )?(confidential|secret)|(stay|remain) on (the )?(call|line|video)|do not (disconnect|hang up|cut)|(confidential|secret) (case|matter|investigation)\\b/gi },\n    { key: 'money', label: 'Money transfer demand', weight: 25,\n      why: 'No government agency asks you to move money to a \"safe\" or \"verification\" account. This is the end goal of the scam.',\n      re: /\\b(transfer (the )?(money|amount|funds|rs\\.?|₹|inr)|send (the )?(money|amount)|(rbi|safe|secure|government|verification) account|verification (amount|fee)|security deposit|settlement amount|pay (a )?(fine|bail|penalty)|bail amount|deposit (the )?(money|amount)|upi (id|to)|refundable|clear your name by paying)\\b/gi },\n    { key: 'sensitive', label: 'Sensitive info / remote access request', weight: 20,\n      why: 'Banks and officials never ask for OTP, PIN, CVV or remote access to your phone.',\n      re: /\\b(share (your )?(otp|pin|cvv|password|card number|aadhaar( number)?|pan( number)?)|(send|tell|give) (me )?(your )?(otp|pin|cvv|password)|screen ?shar(e|ing)|anydesk|teamviewer|quick ?support|install (this |the )?(app|apk)|download (this |the )?(app|apk)|aadhaar (and|&) pan|bank (details|statement) (for|to) verif)/gi }\n  ];\n\n  const hits = [];\n  const matchedCats = new Set();\n  let score = 0;\n  for (const c of cats) {\n    c.re.lastIndex = 0;\n    let m, any = false;\n    while ((m = c.re.exec(t)) !== null) {\n      any = true;\n      hits.push({ phrase: m[0].trim(), category: c.label, why: c.why, index: m.index });\n      if (m.index === c.re.lastIndex) c.re.lastIndex++;\n    }\n    if (any) { matchedCats.add(c.key); score += c.weight; }\n  }\n  if (matchedCats.size >= 3) score += 10;\n  if (matchedCats.has('fake_authority') && matchedCats.has('money')) score += 10;\n  if (matchedCats.has('secrecy') && matchedCats.has('money')) score += 5;\n\n  // Legit-message damping: genuine bank/govt alerts warn AGAINST sharing OTP, etc.\n  const legit = /\\b(never share|do not share|don'?t share|if (this|it) wasn'?t you|if you did not|not you\\?|call 1930|bank will never ask|official (website|app)|visit (your )?(nearest )?branch)\\b/i.test(t);\n  const hardScam = matchedCats.has('secrecy') || matchedCats.has('threat') || matchedCats.has('fake_authority');\n  if (legit && !hardScam) score = Math.round(score * 0.3);\n  // Warning phrases like \"never share OTP\" should not count as an OTP request\n  if (legit) {\n    for (let i = hits.length - 1; i >= 0; i--) {\n      const ctx = t.slice(Math.max(0, hits[i].index - 25), hits[i].index).toLowerCase();\n      if (hits[i].category.startsWith('Sensitive') && /(never|not|n'?t) $/.test(ctx)) hits.splice(i, 1);\n    }\n  }\n\n  score = Math.min(100, score);\n  const level = score >= 60 ? 'HIGH' : score >= 30 ? 'MEDIUM' : 'LOW';\n  hits.sort((a, b) => a.index - b.index);\n  return { rule_score: score, rule_level: level, categories: [...matchedCats], highlights: hits };\n}\nif (typeof module !== 'undefined') module.exports = { analyze };\n\n\nreturn JSON.stringify(analyze(String(query || '')));"
      },
