    {
      "parameters": {
        "jsCode": "const out = $('Scam Analyst Agent').first().json.output || {};\nconst inp = $('Has Text').first().json;\nlet score = Math.max(0, Math.min(100, Math.round(Number(out.risk_score) || 0)));\nconst rule = Math.round(Number(out.rule_score) || 0);\nif (rule >= 60) score = Math.max(score, rule);   // strong rule evidence is never diluted by the LLM\nconst level = score >= 60 ? 'HIGH' : score >= 30 ? 'MEDIUM' : 'LOW';\n\nlet links = [];\ntry { links = ($('Search the web').first().json.results || []); } catch (e) { links = []; }\nconst similar = links.filter(r => r && /^https?:\\/\\//i.test(r.url || '')).slice(0, 3)\n  .map(r => ({ title: String(r.title || r.url).slice(0, 120), url: r.url }));\n\nconst flags = (out.highlights || []).slice(0, 3).map(h => ({ phrase: h.phrase, category: h.category, why: h.why }));\nconst actions = level === 'LOW'\n  ? ['Never share OTP/PIN with anyone.', 'Verify unexpected requests on the official app or website.']\n  : ['Stop. Don\\'t pay or share OTP/details.',\n     'Real police/CBI never arrest over a call or video.',\n     'Verify via the official website number, not this contact.',\n     'Paid already? Call 1930, report at cybercrime.gov.in'];\n\nconst result = {\n  ok: true,\n  risk: { score, level },\n  scam_type: out.scam_type || 'None',\n  summary: out.summary || '',\n  red_flags: flags,\n  actions,\n  similar_cases: level === 'LOW' ? [] : similar,\n  analyzed_text: String(inp.text || '').slice(0, 3000),\n  input_type: inp.source || 'text',\n  disclaimer: 'Automated aid, not a verdict. You decide.',\n  analyzed_at: new Date().toISOString()\n};\nreturn [{ json: { channel: inp.channel || 'telegram', result } }];"
      },
