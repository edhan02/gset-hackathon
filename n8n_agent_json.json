    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"risk_score\": {\n      \"type\": \"number\"\n    },\n    \"rule_score\": {\n      \"type\": \"number\"\n    },\n    \"level\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"LOW\",\n        \"MEDIUM\",\n        \"HIGH\"\n      ]\n    },\n    \"scam_type\": {\n      \"type\": \"string\",\n      \"description\": \"2-5 words\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence, max 15 words\"\n    },\n    \"highlights\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"phrase\": {\n            \"type\": \"string\",\n            \"description\": \"Exact words from the message, max 8 words\"\n          },\n          \"category\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Fake authority\",\n              \"Threat/arrest\",\n              \"Urgency\",\n              \"Secrecy\",\n              \"Money demand\",\n              \"Sensitive info request\"\n            ]\n          },\n          \"why\": {\n            \"type\": \"string\",\n            \"description\": \"Max 10 words\"\n          }\n        },\n        \"required\": [\n          \"phrase\",\n          \"category\",\n          \"why\"\n        ]\n      },\n      \"maxItems\": 3\n    }\n  },\n  \"required\": [\n    \"risk_score\",\n    \"rule_score\",\n    \"level\",\n    \"scam_type\",\n    \"summary\",\n    \"highlights\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1184,
        208
      ],
      "id": "9a021fa8-c3a8-4633-9393-7677473e1d16",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const r = $json.result;\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\nconst { score, level } = r.risk;\nconst icon = { HIGH: '\\u{1F6A8}', MEDIUM: '⚠️', LOW: '✅' }[level];\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst cut = (s, n) => { s = String(s || '').trim(); return s.length > n ? s.slice(0, n - 1) + '…' : s; };\n\nlet msg;\nif (level === 'LOW') {\n  msg = `${icon} <b>LOW RISK</b> · ${score}/100\\nNo strong scam signs found.\\nStill: never share OTP/PIN, and verify unexpected requests on the official app or website.`;\n} else {\n  msg = `${icon} <b>${level} RISK</b> · ${score}/100`;\n  if (r.scam_type && r.scam_type !== 'None') msg += `\\nType: ${esc(cut(r.scam_type, 40))}`;\n  if (r.red_flags.length) {\n    msg += '\\n\\n\\u{1F50E} <b>Red flags</b>';\n    for (const h of r.red_flags) msg += `\\n• \"${esc(cut(h.phrase, 50))}\" → ${esc(h.category)}: ${esc(cut(h.why, 70))}`;\n  }\n  msg += '\\n\\n\\u{1F6D1} <b>Do now</b>';\n  r.actions.forEach((a, i) => { msg += `\\n${i + 1}. ${esc(a)}`; });\n  if (r.similar_cases.length) {\n    msg += '\\n\\n\\u{1F4F0} <b>Similar cases</b>';\n    for (const c of r.similar_cases) {\n      const href = String(c.url).replace(/&/g, '&amp;').replace(/\"/g, '&quot;');\n      msg += `\\n• <a href=\"${href}\">${esc(cut(c.title, 70))}</a>`;\n    }\n  }\n  msg += `\\n\\n<i>${esc(r.disclaimer)}</i>`;\n}\nreturn [{ json: { chat_id: chatId, message: msg } }];"
      },
